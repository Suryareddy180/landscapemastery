# Django & JWT Secret (REQUIRED — generate a strong random key for production)
JWT_SECRET=your_strong_random_secret_key_here

# Production Settings
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional: Single PostgreSQL Connection URL (e.g., Railway, Render, Supabase, Neon)
# If DATABASE_URL is set, it takes precedence over the separate DB_* variables below:
# DATABASE_URL=postgresql://postgres:password@db.xyz.supabase.co:5432/postgres?sslmode=require

# PostgreSQL Database Configuration (used if DATABASE_URL is not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=landscapemastery
DB_USER=postgres
DB_PASSWORD=your_strong_db_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# Frontend Production URL (used in transactional emails & redirects)
FRONTEND_URL=https://yourdomain.com

# Database Connection Pooling / Max Age (seconds)
DB_CONN_MAX_AGE=600

# Optional HTTPS/SSL Enforcement (enable if SSL is not terminated by cloud proxy)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Razorpay Credentials (use LIVE keys in production)
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_live_razorpay_secret

# Django SMTP Email Service Credentials
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email_address
EMAIL_HOST_PASSWORD=your_smtp_app_password
DEFAULT_FROM_EMAIL=Landscape Mastery <noreply@yourdomain.com>

# Admin notification email
CONTACT_NOTIFICATION_EMAIL=admin@yourdomain.com
