# =================================================================
# Landscape Mastery - Production Environment Configuration Template
# Copy this file to .env.production on your production VPS:
# cp .env.production.example .env.production
# =================================================================

# --- Core Security & Django ---
DEBUG=False
# Generate a strong 64+ char key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SECRET=replace_with_64_char_random_cryptographic_secret_key
SECRET_KEY=replace_with_64_char_random_cryptographic_secret_key

# --- Hostnames & CORS ---
# Set to your production domain(s)
ALLOWED_HOSTS=landscapemastery.com,www.landscapemastery.com,127.0.0.1,localhost,backend,frontend
CORS_ALLOWED_ORIGINS=https://landscapemastery.com,https://www.landscapemastery.com
CSRF_TRUSTED_ORIGINS=https://landscapemastery.com,https://www.landscapemastery.com
FRONTEND_URL=https://landscapemastery.com

# --- PostgreSQL Database ---
# Password used by both the postgres container and Django backend
DB_PASSWORD=replace_with_strong_database_password
DB_CONN_MAX_AGE=600

# --- Razorpay Payment Gateway ---
# Use live credentials in production
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_secret_key

# --- Outbound Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Landscape Mastery <noreply@landscapemastery.com>
CONTACT_NOTIFICATION_EMAIL=admin@landscapemastery.com
